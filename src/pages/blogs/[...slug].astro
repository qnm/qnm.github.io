---
import { getCollection, render } from "astro:content"
import { Image } from "astro:assets"
import Layout from "../../layouts/Layout.astro"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Layout title={post.data.title} description={post.data.subtitle}>
  <div class="post-page-container">
    <div class="post-page-flex-container">
      {
        post.data.image && (
          <div class="post-image-container">
            <Image
              class="post-image"
              src={post.data.image}
              alt={post.data.title}
              width={1200}
            />
          </div>
        )
      }
      <div class="post-content-container">
        <h1>{post.data.title}</h1>
        {
          (post.data.date || post.data.read) && (
            <h4 style="color: rgb(165, 164, 164); font-size: 0.8em;">
              {post.data.date}
              {post.data.date && post.data.read ? " - " : ""}
              {post.data.read}
            </h4>
          )
        }
        <Content />
      </div>
    </div>
  </div>
</Layout>
