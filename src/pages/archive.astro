---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"
import { displayHost } from "../lib/link"

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

// Group by year for readability
const byYear = new Map<number, typeof posts>()
for (const p of posts) {
  const y = p.data.date.getUTCFullYear()
  if (!byYear.has(y)) byYear.set(y, [])
  byYear.get(y)!.push(p)
}
const years = Array.from(byYear.keys()).sort((a, b) => b - a)

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { month: "short", day: "numeric" })
---

<Layout title="Archive">
  <div class="archive-container">
    <h1>Archive</h1>
    <p class="archive-subtitle">
      Every post ever, {posts.length} in total, going back to {years[years.length - 1]}.
    </p>
    {
      years.map((year) => (
        <section class="archive-year">
          <h2>{year}</h2>
          <ul>
            {byYear.get(year)!.map((p) => {
              const permalink = `/blogs/${p.id.replace(/\.(md|mdx)$/, "")}/`
              const isLink = p.data.topic === "link" && !!p.data.link
              return (
                <li class:list={["archive-row", { "is-link": isLink }]}>
                  <span class="archive-date">{fmt(p.data.date)}</span>
                  <span class="archive-entry">
                    {isLink && <span class="link-glyph" aria-hidden="true">→</span>}
                    <a href={permalink}>{p.data.title}</a>
                    {isLink && (
                      <a
                        class="archive-host"
                        href={p.data.link}
                        rel="external noopener"
                      >
                        {displayHost(p.data.link!)}
                      </a>
                    )}
                  </span>
                </li>
              )
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .archive-container {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .archive-container h1 {
    margin-bottom: 0.25rem;
  }
  .archive-subtitle {
    color: #73737d;
    margin-bottom: 2.5rem;
  }
  .archive-year {
    margin-bottom: 2rem;
  }
  .archive-year h2 {
    font-size: 1.15rem;
    color: #73737d;
    border-bottom: 1px solid #eee;
    padding-bottom: 0.25rem;
    margin-bottom: 0.75rem;
  }
  .archive-year ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .archive-row {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding: 0.25rem 0;
    line-height: 1.5;
  }
  .archive-entry {
    display: inline;
  }
  .link-glyph {
    color: #a5a4a4;
    margin-right: 0.35rem;
  }
  .archive-host {
    color: #a5a4a4 !important;
    font-size: 0.85em;
    margin-left: 0.5rem;
  }
  .archive-host::before {
    content: "(";
  }
  .archive-host::after {
    content: ")";
  }
  .archive-host:hover {
    color: #333 !important;
  }
  .archive-date {
    color: #a5a4a4;
    font-variant-numeric: tabular-nums;
    font-size: 0.9em;
  }
  .archive-year a {
    color: inherit;
    text-decoration: none;
  }
  .archive-year a:hover {
    text-decoration: underline;
  }
</style>
