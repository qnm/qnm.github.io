---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"
import { displayHost } from "../lib/link"

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

const byYear = new Map<number, typeof posts>()
for (const p of posts) {
  const y = p.data.date.getUTCFullYear()
  if (!byYear.has(y)) byYear.set(y, [])
  byYear.get(y)!.push(p)
}
const years = Array.from(byYear.keys()).sort((a, b) => b - a)

const iso = (d: Date) => d.toISOString().slice(0, 10)

type Post = (typeof posts)[number]
const permalink = (p: Post) => `/blogs/${p.id.replace(/\.(md|mdx)$/, "")}/`
---

<Layout title="archive">
  <h1>archive</h1>
  <p class="muted">
    {posts.length} posts, going back to {years[years.length - 1]}.
  </p>

  {
    years.map((year) => (
      <section class="archive-year">
        <h2>{year}</h2>
        <ul class="post-list">
          {byYear.get(year)!.map((p) => {
            const isLink = p.data.topic === "link" && !!p.data.link
            return (
              <li class="post-row">
                <span class="row-date">{iso(p.data.date)}</span>
                <span>
                  {isLink && <span class="link-glyph" aria-hidden="true">→</span>}
                  <a class="row-title" href={permalink(p)}>
                    {p.data.title}
                  </a>
                  {isLink && (
                    <a
                      class="row-host"
                      href={p.data.link}
                      rel="external noopener"
                    >
                      {displayHost(p.data.link!)}
                    </a>
                  )}
                </span>
              </li>
            )
          })}
        </ul>
      </section>
    ))
  }
</Layout>
