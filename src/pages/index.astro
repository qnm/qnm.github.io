---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"
import FeaturedBlog from "../components/FeaturedBlog.astro"
import BlogCards from "../components/BlogCards.astro"

const RECENT_LIMIT = 12

const all = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

const featured = all.filter((p) => p.data.topic === "feature")
const nonFeatured = all.filter((p) => p.data.topic !== "feature")
const recent = nonFeatured.slice(0, RECENT_LIMIT)
const hasMore = nonFeatured.length > RECENT_LIMIT
---

<Layout title="Home">
  <FeaturedBlog posts={featured} />
  <BlogCards posts={recent} />
  {
    hasMore && (
      <p style="text-align: center; margin: 2rem 0 3rem;">
        <a href="/archive/" style="text-decoration: none;">
          See the full archive ({nonFeatured.length} posts) →
        </a>
      </p>
    )
  }
</Layout>
