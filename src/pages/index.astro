---
import { getCollection, render } from "astro:content"
import Layout from "../layouts/Layout.astro"
import { displayHost } from "../lib/link"

const RECENT_LIMIT = 20

const all = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

const isFeatured = (p: (typeof all)[number]) =>
  p.data.topic === "feature" || p.data.featured === true
const featured = all.filter(isFeatured)
const nonFeatured = all.filter((p) => !isFeatured(p))
const recent = nonFeatured.slice(0, RECENT_LIMIT)
const remaining = nonFeatured.length - recent.length

const iso = (d: Date) => d.toISOString().slice(0, 10)

type Post = (typeof all)[number]
const permalink = (p: Post) => `/blogs/${p.id.replace(/\.(md|mdx)$/, "")}/`

// Pre-render the body of featured highlights so we can show the quote
// itself on the homepage rather than just a title.
const featuredRendered = await Promise.all(
  featured.map(async (p) => ({
    p,
    Content: p.data.topic === "highlight" ? (await render(p)).Content : null,
  }))
)
---

<Layout title="rob sharp">
  <section class="intro">
    <p>
      A rough archive of things I've found interesting since 2005 — technology,
      music, and a long tail of link posts from an era when everyone had a
      Delicious account and thought RSS would save the world.
    </p>
  </section>

  {
    featured.length > 0 && (
      <>
        <h2>featured</h2>
        <ul class="post-list">
          {featuredRendered.map(({ p, Content }) => (
            <li class="post-row is-feature">
              <span class="row-date">{iso(p.data.date)}</span>
              <span>
                {Content ? (
                  <div class="feature-quote">
                    <Content />
                    <a class="feature-quote-link" href={permalink(p)}>
                      {p.data.link ? displayHost(p.data.link) : "read the highlight"} →
                    </a>
                  </div>
                ) : (
                  <>
                    <a class="row-title" href={permalink(p)}>
                      {p.data.title}
                    </a>
                    {p.data.subtitle && (
                      <div class="post-subtitle" style="margin-left:0">
                        {p.data.subtitle}
                      </div>
                    )}
                  </>
                )}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2>recent</h2>
  <ul class="post-list">
    {
      recent.map((p) => {
        const isLink = p.data.topic === "link" && !!p.data.link
        return (
          <li class="post-row">
            <span class="row-date">{iso(p.data.date)}</span>
            <span>
              {isLink && <span class="link-glyph" aria-hidden="true">→</span>}
              <a class="row-title" href={permalink(p)}>
                {p.data.title}
              </a>
              {isLink && (
                <a
                  class="row-host"
                  href={p.data.link}
                  rel="external noopener"
                >
                  {displayHost(p.data.link!)}
                </a>
              )}
            </span>
          </li>
        )
      })
    }
  </ul>

  {
    remaining > 0 && (
      <p class="muted" style="margin-top: 2rem;">
        <a href="/archive/">see the full archive ({nonFeatured.length} posts) →</a>
      </p>
    )
  }
</Layout>
