---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

interface Props {
  posts: CollectionEntry<"blog">[]
}

const { posts } = Astro.props
const featured = posts.filter((p) => p.data.topic === "feature")
---

<div class="featured-blog-container">
  {
    featured.map((post) => (
      <a
        href={`/blogs/${post.id.replace(/\.(md|mdx)$/, "")}/`}
        style="text-decoration: none; color: inherit;"
      >
        <div class="featured-blog-card">
          {post.data.image && (
            <Image
              class="featured-blog-thumbnail"
              src={post.data.image}
              alt={post.data.title}
              width={1200}
            />
          )}
          <div class="featured-blog-description">
            <h3 class="featured-blog-title">{post.data.title}</h3>
            <p class="featured-blog-excerpt">{post.data.subtitle ?? ""}</p>
            <p class="featured-read-more">
              Read More{post.data.read ? ` - ${post.data.read}` : ""}
            </p>
          </div>
        </div>
      </a>
    ))
  }
</div>
