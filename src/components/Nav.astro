---
const pathname = Astro.url.pathname
const isPost = pathname.includes("/blogs/")
const isAbout = pathname.startsWith("/about")
const isArchive = pathname.startsWith("/archive")
const isHome = !isPost && !isAbout && !isArchive
---

<div class={isPost ? "post-nav-container" : "nav-container"} id="nav-bar">
  <a href="/" class="nav-brand">Rob Sharp</a>
  <ul class="nav-item-container">
    <li class={isHome ? "nav-item active-link" : "nav-item"} id="nav-home">
      <a href="/">Home</a>
      <div class="underline"></div>
    </li>
    <li class={isAbout ? "nav-item active-link" : "nav-item"}>
      <a href="/about/">About</a>
      <div class="underline"></div>
    </li>
    <li class={isArchive ? "nav-item active-link" : "nav-item"}>
      <a href="/archive/">Archive</a>
      <div class="underline"></div>
    </li>
  </ul>
</div>
